PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/crumbio

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Mail (OTP for forgot password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Crumbio <no-reply@crumbio.local>

# Khalti payment gateway — sandbox merchant account from https://test-admin.khalti.com
# (Settings > Keys). Base URL must be a.khalti.com for this account type.
# Demo wallet for testing: 9800000000-9800000005, PIN 1111, OTP 987654.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://a.khalti.com/api/v2
